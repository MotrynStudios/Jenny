# One Discord application and bot token is shared by the Python and optional
# Node.js voice processes. Both log in as the same bot identity.
DISCORD_TOKEN=

# Model/API keys: backup keys use the same model IDs as the primary key.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GEMINI_API_KEY=
TAVILY_API_KEY=
TAVILY_API_KEY_BACKUP=
DEEPGRAM_API_KEY=

# Main model IDs (the Groq backup reuses the corresponding Groq model).
OPENROUTER_MODEL=openai/gpt-oss-120b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=
DEEPGRAM_TTS_MODEL=flux-haley-en
GEMINI_MODEL=gemini-3.6-flash

# Optional local services and tuning
PYTHON_API_URL=http://127.0.0.1:8000
WAKE_WORD=jenny
FFMPEG_PATH=
AI_MAX_TOKENS=1500
VISION_MAX_TOKENS=300
RAG_MAX_DISTANCE=1.4
DATA_RETENTION_DAYS=90
