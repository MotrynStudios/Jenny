# One Discord application and bot token is shared by the Python and optional
# Node.js voice processes. Both log in as the same bot identity.
DISCORD_TOKEN=

# Model/API keys: backup keys use the same model IDs as the primary key.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GEMINI_API_KEY=
TAVILY_API_KEY=
TAVILY_API_KEY_BACKUP=
DEEPGRAM_API_KEY=
# Optional public issue submission. Grant Issues: write only on the target repo.
GITHUB_REPORT_TOKEN=
GITHUB_REPORT_REPO=MotrynStudios/Jenny-AI-Discord-Bot

# Default provider model IDs. Per-server chat and vision preferences can be
# changed at runtime with /setmodel; backup accounts reuse the same model ID.
OPENROUTER_MODEL=openai/gpt-oss-120b:free
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=
DEEPGRAM_TTS_MODEL=flux-haley-en
GEMINI_MODEL=gemini-3.6-flash

# Optional local services and tuning
PYTHON_API_URL=http://127.0.0.1:8000
AI_MAX_TOKENS=1500
VISION_MAX_TOKENS=300
RAG_MAX_DISTANCE=1.4
# Keep local embedding rebuilds responsive on laptops. Thread caps affect
# indexing speed only, not embedding vectors or answer quality.
RAG_CPU_THREADS=2
RAG_INDEX_BATCH_SIZE=64
RAG_EMBED_BATCH_SIZE=16
# Optional. Defaults off to reduce startup time and idle memory; the first RAG
# question loads the model. Set true if you prefer a warm index on launch.
RAG_PREWARM=false
DATA_RETENTION_DAYS=90
